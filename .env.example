# Required: fill these locally or in hosting environment settings.
# URL and public key from YOUR own compatible backend project.
# No private credentials from Lovable Cloud are included or required.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: unused by the current storefront; project identifier for future tooling.
VITE_SUPABASE_PROJECT_ID=
# Optional: node-server (default), vercel, netlify, cloudflare-module
NITRO_PRESET=node-server
# Optional: Node production server
PORT=3000
HOST=0.0.0.0
